# 公网 HTTPS 站点域名。支付平台必须能访问该域名下的 /api/payments/*/notify 回调。
PAYMENT_PUBLIC_BASE_URL=https://shop.example.com

# 支付宝当面付（证书/公钥模式；路径相对于项目根目录）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=secrets/alipay-merchant-private.pem
ALIPAY_PUBLIC_KEY_PATH=secrets/alipay-platform-public.pem
# 可选：不填时使用支付宝正式网关
ALIPAY_GATEWAY=
# 可选：不填时使用 PAYMENT_PUBLIC_BASE_URL 拼接回调路径
ALIPAY_NOTIFY_URL=

# 微信支付 Native 扫码支付（API v3）
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY_PATH=secrets/wechat-merchant-private.pem
WECHAT_API_V3_KEY=
# 微信支付平台证书（二选一：平台证书，或公钥文件 + 公钥 ID）
WECHAT_PLATFORM_CERT_PATH=secrets/wechatpay-platform.pem
WECHAT_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PLATFORM_SERIAL_NO=
# 可选：不填时使用微信支付正式网关
WECHAT_API_BASE=
# 可选：不填时使用 PAYMENT_PUBLIC_BASE_URL 拼接回调路径
WECHAT_NOTIFY_URL=
